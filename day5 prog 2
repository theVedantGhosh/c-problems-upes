//Q10: Write a program to input time in seconds and convert it to hours:minutes:seconds format.

#include <stdio.h>
int main(){
	int s,h,m,l;
    printf("enter time in seconds: ");
	scanf("%d" ,&s);
	h=s/3600;
	m=(s-(h*3600))/60;
	l=s-h*3600-m*60;
	printf("the time in hours:minutes:seconds is %d:%d:%d" ,h,m,l);
    return 0;
}

