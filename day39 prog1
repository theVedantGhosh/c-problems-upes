//Q77: Check if the elements on the diagonal of a matrix are distinct.

/*
Sample Test Cases:
Input 1:
3 3
1 2 3
4 5 6
7 8 1
Output 1:
False

Input 2:
3 3
1 2 3
4 5 6
7 8 9
Output 2:
True

*/
#include<stdio.h>
int main() {
    int n,w,sum=0,sum2=0,l,q,flag=1;
	printf("enter the number of rows: ");
	scanf("%d",&n);
	printf("enter the number of coloumn: ");
	scanf("%d",&w);
	int arr[n][w];
	if (n==w) {
    for (int i=0;i<n;i++) {
		for (int j=0;j<w;j++) {
			printf("enter the value for %d row and %d coloumn: ",i+1,j+1);
			scanf("%d",&arr[i][j]);
        }
        printf("\n");
	}
	 for (int i=0;i<n;i++) {
		for (int j=0;j<w;j++) {
			if (arr[i][j]!=arr[i+1][j+1]) {
				flag=1;
				break;
			}
		}
	 }
	 if (flag) {
		 printf("true");
	 }
	 else {
		 printf("false");
	 }
	}
	else {
		printf("not a square matrix");
	}
	return 0;
}
