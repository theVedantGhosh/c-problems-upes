//Q73: Find the sum of each row of a matrix and store it in an array.

/*
Sample Test Cases:
Input 1:
2 3
1 2 3
4 5 6
Output 1:
6 15

*/
#include<stdio.h>
int main() {
    int n,w,sum=0,sum2=0;
	printf("enter the number of rows: ");
	scanf("%d",&n);
	printf("enter the number of coloumn: ");
	scanf("%d",&w);
	int arr[n][w];
    for (int i=0;i<n;i++) {
        for (int j=0;j<w;j++) {
			printf("enter the value for %d row and %d coloumn: ",i+1,j+1);
			scanf("%d",&arr[i][j]);
        }
        printf("\n");
    }
	 for (int j=0;j<w;j++) {
		 sum=sum+arr[0][j];
	 }
	  for (int j=0;j<w;j++) {
		  sum2=sum2+arr[1][j];
	  }
	  printf("%d %d",sum,sum2);

    return 0;
}
