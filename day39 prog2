//Q78: Find the sum of main diagonal elements for a square matrix.

/*
Sample Test Cases:
Input 1:
3 3
1 2 3
4 5 6
7 8 9
Output 1:
15

*/
#include<stdio.h>
int main() {
    int n,w,sum=0,l,q,flag=1;
	printf("enter the number of rows: ");
	scanf("%d",&n);
	printf("enter the number of coloumn: ");
	scanf("%d",&w);
	int arr[n][w];
	if (n==w) {
    for (int i=0;i<n;i++) {
		for (int j=0;j<w;j++) {
			printf("enter the value for %d row and %d coloumn: ",i+1,j+1);
			scanf("%d",&arr[i][j]);
        }
        printf("\n");
	}
	 for (int i=0;i<n;i++) {
		for (int j=0;j<w;j++) {
			if (i==j) {
				sum=sum+arr[i][j];
			}
		}
	 }
	 printf("%d",sum);
	}
	else {
		printf("not a square matrix");
	}
	return 0;
}
