//Q9: Write a program to calculate simple and compound interest for given principal, rate, and time.
/*
Sample Test Cases:
Input 1:
1000 5 2
Output 1:
Simple Interest=100, Compound Interest=102.5

Input 2:
5000 7 3
Output 2:
Simple Interest=1050, Compound Interest=1125.76

*/

#include <stdio.h>
#include <math.h>
int main(){
	float a,b,c;
	printf("enter the principal amount: ",a);
	scanf("%f",&a);
	printf("enter the time period: ",b);
	scanf("%f",&b);
	printf("enter the rate of interest: ",c);
	scanf("%f",&c);
	printf("the simple interest is: %f ", a*b*c/100);
	printf("the compound interest is: %f ",(a*pow((1+c/100),b)-a));
    return 0;
} 

