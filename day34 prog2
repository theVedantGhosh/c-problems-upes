//Q68: Delete an element from an array.

/*
Sample Test Cases:
Input 1:
5
1 2 3 4 5
2
Output 1:
1 2 4 5

*/
#include <stdio.h>

int main() {
    int w,x,j;
	scanf("%d",&x);
	int a[x];
	for (int i=0;i<x;i++) {
		printf("enter element %d: ",i+1);
		scanf("%d",&a[i]);
	}
	scanf("%d",&w);
	for (int i=w;i<x-1;i++) {
		a[i]=a[i+1];
	}
	for (int i=0;i<x-1;i++) {
		printf("%d",a[i]);
	}
	
	return 0;
	
}
