//Q76: Check if a matrix is symmetric.

/*
Sample Test Cases:
Input 1:
2 2
1 2
2 1
Output 1:
True

Input 2:
2 2
1 0
2 1
Output 2:
False

*/
#include<stdio.h>
int main() {
    int n,w,sum=0,sum2=0,l,q;
	printf("enter the number of rows: ");
	scanf("%d",&n);
	printf("enter the number of coloumn: ");
	scanf("%d",&w);
	int arr[n][w];
	if (n==w) {
    for (int i=0;i<n;i++) {
		for (int j=0;j<w;j++) {
			printf("enter the value for %d row and %d coloumn: ",i+1,j+1);
			scanf("%d",&arr[i][j]);
        }
        printf("\n");
	}
	for (int i=0;i<n;i++) {
		for (int j=0;j<w;j++) {
			if (arr[i][j]!=arr[j][i]) {
				break;
				printf("false");
			}
			else {
				printf("true");
			}
		}
	}
	}
	else {
		printf("false");
	}
	return 0;
}
