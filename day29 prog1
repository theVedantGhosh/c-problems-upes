//Q57: Find the sum of array elements.

/*
Sample Test Cases:
Input 1:
4
2 4 6 8
Output 1:
20

Input 2:
3
1 1 1
Output 2:
3

*/
#include<stdio.h>
int main() {
	int x,sum=0;
	printf("enter the number: "); 
	scanf("%d",&x);
	int a[x],i;
	for (i=0;i<x;i++) {
		printf("enter the %d number: ",i+1);
		scanf("%d",&a[i]);
	}
	for (i=0;i<x;i++) {
		//printf("%d ", a[i]);
		sum=sum+a[i];
	}
	printf("\n");
	printf("%d",sum);
	return 0;
}
